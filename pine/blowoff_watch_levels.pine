// blowoff-watch — Blow-off Top Detector · levels edition (Pine v6)
// =================================================================
// State machine over the 5 TradingSim blow-off top criteria:
//   #1 massive staircase uptrend (no >78.6% retracement)
//   climax: parabolic push above the projected regression channel
//   #2+#4 vicious drop on heavy volume
//   #3 benchmark / broad market topping (optional)
//   #5 weak counter-rally  -> CONFIRMED
//
// Draws forward: projected channel + climax trigger line BEFORE the blow-off,
// and after the drop marks the TOP / LOW plus the weak-bounce ceiling (default
// 50%) and invalidation (default 78.6%) retracement levels extended right. Levels
// track the structure live as new extremes print. Invalidated patterns are
// wiped off the chart; confirmed blow-offs stay as a frozen record.
//
// Optional "scenario fan": three dashed templates per state — ① the pattern
// path, ② the bullish alternative, ③ the bearish alternative — projected
// forward. NOT forecasts: maps of where the scenarios diverge and where
// the decision levels sit.
//
// The state machine advances on CONFIRMED bars only — no intrabar repaint.
// Alerts: one "Any alert() function call" alert gets dynamic messages at every
// stage, or use the four alertcondition() entries.
//
// Not financial advice. Detection tool, not an entry button.

//@version=6
indicator("Blowoff Watch (levels)", overlay = true, max_lines_count = 60, max_labels_count = 60, max_polylines_count = 10, max_bars_back = 500)

// ---------------------------------------------------------------- inputs

grpT = "#1 Uptrend"
trendLen      = input.int(300,    "Trend lookback (bars)",       minval = 60, maxval = 480, group = grpT)
minGainATR    = input.float(8.0,  "Min advance (ATR)",           group = grpT)
minGainPct    = input.float(0.0,  "Min advance (%, 100 = +100%)", minval = 0, group = grpT)
maxRetrIn     = input.float(0.786, "Max retracement",            group = grpT, step = 0.01, minval = 0.5, maxval = 1.0)
minR2         = input.float(0.70, "Min regression R²",           group = grpT, step = 0.01)

grpC = "Climax"
chLen         = input.int(120,   "Channel lookback",             minval = 30, maxval = 480, group = grpC)
accelLen      = input.int(12,    "Acceleration window",          minval = 3, group = grpC)
accelRatioIn  = input.float(2.5, "Accel ratio (local/channel slope)", group = grpC)
chBreakATR    = input.float(1.0, "Break above channel (ATR)",    group = grpC)
rsiClimax     = input.float(75,  "RSI climax level",             group = grpC)
volZClimax    = input.float(2.0, "Volume z-score (climax)",      group = grpC)
climaxGrace   = input.int(40,    "Grace bars after climax",      group = grpC)

grpD = "#2+#4 Vicious drop"
dropWin       = input.int(16,    "Drop window (bars)",           minval = 3, group = grpD)
dropATRIn     = input.float(3.0, "Vicious drop size (ATR)",      group = grpD)
downVolZ      = input.float(1.5, "Down-bar volume z-score",      group = grpD)

grpB = "#5 Weak bounce"
maxBounce     = input.float(0.50, "Max bounce retrace",          group = grpB, step = 0.01)
failRetr      = input.float(0.786, "Invalidation retrace",       group = grpB, step = 0.001)
bounceMin     = input.int(3,     "Min bounce bars",              minval = 1, group = grpB)
bounceTimeout = input.int(60,    "Bounce timeout (bars)",        group = grpB)
bounceVolZMax = input.float(0.0, "Max mean bounce volume z",     group = grpB, step = 0.1)

grpM = "#3 Benchmark"
useBench      = input.bool(false, "Use benchmark filter",        group = grpM)
benchSym      = input.symbol("CME_MINI:ES1!", "Benchmark",       group = grpM)
benchEma      = input.int(50,    "Benchmark EMA",                minval = 2, group = grpM)

grpV = "Drawing"
showChannel   = input.bool(true, "Project channel + trigger line", group = grpV)
projBars      = input.int(20,    "Project channel right (bars)",   minval = 0, maxval = 500, group = grpV)
lvlBars       = input.int(40,    "Extend drop levels right (bars)", minval = 0, maxval = 500, group = grpV)

grpI = "Indicators"
atrLen   = input.int(14, "ATR length",       minval = 1, group = grpI)
rsiLen   = input.int(14, "RSI length",       minval = 1, group = grpI)
volMaLen = input.int(50, "Volume MA length", minval = 2, group = grpI)

// ---------------------------------------------------------------- indicators

atr   = ta.atr(atrLen)
rsi   = ta.rsi(close, rsiLen)
volSd = ta.stdev(volume, volMaLen)
volZ  = volSd > 0 ? (volume - ta.sma(volume, volMaLen)) / volSd : 0.0

// enough history for every lookback loop before the machine may arm
ready = bar_index >= math.max(trendLen, math.max(chLen, volMaLen))

// ---------------------------------------------------------------- criterion #1

f_uptrend() =>
    hiVal = -1e18
    hiIdx = 0
    for i = 0 to trendLen - 1
        if high[i] >= hiVal   // >= keeps the OLDEST equal high, like np.argmax
            hiVal := high[i]
            hiIdx := i
    loVal = 1e18
    loIdx = hiIdx
    for i = hiIdx to trendLen - 1
        if low[i] <= loVal   // <= keeps the OLDEST equal low, like np.argmin
            loVal := low[i]
            loIdx := i
    gainATR = atr > 0 ? (hiVal - loVal) / atr : 0.0
    gainPct = loVal > 0 ? (hiVal - loVal) / loVal : 0.0
    // walk forward from trend start, measure deepest retracement of the advance
    maxRetr = 0.0
    runHigh = loVal
    for i = loIdx to 0
        runHigh := math.max(runHigh, high[i])
        rng = runHigh - loVal
        if rng > 3 * atr
            maxRetr := math.max(maxRetr, (runHigh - low[i]) / rng)
    r2 = math.pow(ta.correlation(close, bar_index, trendLen), 2)
    slopeOk = ta.linreg(close, trendLen, 0) > ta.linreg(close, trendLen, 1)
    ok = slopeOk and r2 >= minR2 and gainATR >= minGainATR and gainPct * 100 >= minGainPct and maxRetr < maxRetrIn
    [ok, gainATR, maxRetr, hiVal, loVal]

[trendOk, trendGain, trendRetr, trendHi, trendLo] = f_uptrend()

// ---------------------------------------------------------------- climax + projected channel

// Fit the channel on the staircase EXCLUDING the last accelLen bars, then
// extrapolate to "now" (+ forward). Otherwise the upper line would hug the
// blow-off itself and price could never register above it.
bodyLen  = math.max(chLen - accelLen, 2)   // clamp: accelLen >= chLen would kill ta.linreg
src      = close[accelLen]
chSlope  = ta.linreg(src, bodyLen, 0) - ta.linreg(src, bodyLen, 1)
chEnd    = ta.linreg(src, bodyLen, 0)                 // value at bar (now - accelLen)
maxResid = 0.0
for i = 0 to bodyLen - 1
    fitted = chEnd - chSlope * i
    resid  = src[i] - fitted
    maxResid := math.max(maxResid, resid)
midNow   = chEnd + chSlope * accelLen                  // extrapolated midline now
upperNow = midNow + maxResid                           // climax trigger line

localSlope = ta.linreg(close, accelLen, 0) - ta.linreg(close, accelLen, 1)
accelRatio = chSlope != 0 ? localSlope / chSlope : 0.0
aboveATR   = atr > 0 ? (close - upperNow) / atr : 0.0

climaxOk = chSlope > 0 and accelRatio >= accelRatioIn and aboveATR >= chBreakATR and rsi >= rsiClimax and (volZ >= volZClimax or volZ[1] >= volZClimax or volZ[2] >= volZClimax)

// ---------------------------------------------------------------- criteria #2+#4

f_drop() =>
    pkVal = -1e18
    pkIdx = 0
    for i = 0 to dropWin - 1
        if high[i] >= pkVal   // >= keeps the OLDEST equal peak, like np.argmax
            pkVal := high[i]
            pkIdx := i
    loAfter = 1e18
    for i = 0 to pkIdx
        loAfter := math.min(loAfter, low[i])
    dAtr = atr > 0 ? (pkVal - loAfter) / atr : 0.0
    heavy = false
    for i = 0 to pkIdx
        if close[i] < open[i] and volZ[i] >= downVolZ
            heavy := true
    [dAtr >= dropATRIn and heavy, dAtr, pkVal, loAfter]

[dropOk, dropAtrNow, dropPk, dropLo] = f_drop()

// ---------------------------------------------------------------- criterion #3

// Hoisted out of any conditional so the request runs on every bar.
// bHi20 < bHi60 <=> the 60-bar high sits OUTSIDE the last 20 bars = lower high.
[bClose, bEma, bHi20, bHi60] = request.security(useBench ? benchSym : syminfo.tickerid, timeframe.period, [close, ta.ema(close, benchEma), ta.highest(close, 20), ta.highest(close, 60)])
benchTopping = useBench and (bClose < bEma or bHi20 < bHi60)

// ---------------------------------------------------------------- state machine

var int   state      = 0   // 0 NEUTRAL 1 UPTREND 2 CLIMAX 3 DROP 4 BOUNCE 5 CONFIRMED
var float pk         = na
var float lo         = na
var int   climaxBars = 0
var int   bounceBars = 0

weakVol   = ta.sma(volZ, bounceMin) <= bounceVolZMax
prevState = state
bool reclaimReset = false   // reset caused by price reclaiming the drop (only this one alerts)

// Advance on confirmed bars only: on historical bars every bar is confirmed,
// in realtime the machine moves at bar close -> what fired in the past is
// exactly what would have fired live.
if ready and barstate.isconfirmed
    if state <= 1
        if trendOk and climaxOk
            state := 2
            climaxBars := 0
        else
            state := trendOk ? 1 : 0
    else if state == 2
        climaxBars += 1
        if dropOk
            state := 3
            pk := dropPk
            lo := dropLo
            bounceBars := 0
        else if climaxOk
            climaxBars := 0   // climax still hot, keep the clock fresh
        else if climaxBars > climaxGrace
            state := 0        // climax cooled off, no vicious drop -> stand down
    else if state == 3 or state == 4
        // track the extremes, THEN measure the bounce against the fresh range
        pk := math.max(pk, dropPk)
        lo := math.min(lo, dropLo)
        bounceBars += 1
        retr = pk != lo ? (close - lo) / (pk - lo) : 0.0
        if retr >= failRetr
            state := 0        // reclaimed -> not a blow-off, reset
            reclaimReset := true
            pk := na
            lo := na
        else if bounceBars > bounceTimeout
            state := 0
            pk := na
            lo := na
        else if close > lo and retr < maxBounce and weakVol and bounceBars >= bounceMin
            state := 5
        else
            state := 4
    else if state == 5
        retr = pk != lo ? (close - lo) / (pk - lo) : 0.0
        if retr >= failRetr
            state := 0        // structure invalidated -> re-arm
            reclaimReset := true
            pk := na
            lo := na

newClimax    = state == 2 and prevState != 2
newDrop      = state == 3 and prevState != 3
newConfirmed = state == 5 and prevState != 5
invalidated  = state == 0 and (prevState == 3 or prevState == 4)
rearmed      = state == 0 and prevState == 5

// current bounce retrace for display (na when no active structure)
dispRetr = not na(pk) and pk != lo ? (close - lo) / (pk - lo) : na

// ---------------------------------------------------------------- drawing

// Projected channel + climax trigger line, extended into the future.
// Redrawn while the machine is armed (UPTREND / CLIMAX), left frozen through
// the drop phase for context, deleted once the machine is back to NEUTRAL.
var line upLine  = na
var line midLine = na
if barstate.islast
    if showChannel and (state == 1 or state == 2) and chSlope > 0
        line.delete(upLine)
        line.delete(midLine)
        upLine  := line.new(bar_index - chLen, upperNow - chSlope * chLen, bar_index + projBars, upperNow + chSlope * projBars, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
        midLine := line.new(bar_index - chLen, midNow - chSlope * chLen, bar_index + projBars, midNow + chSlope * projBars, color = color.new(color.gray, 40))
    else if state <= 2
        // NEUTRAL, channel display off, or stale slope -> clear; 3..5 stay frozen
        line.delete(upLine)
        line.delete(midLine)
        upLine  := na
        midLine := na

// TOP / LOW + retracement levels after the drop, projected right and kept in
// sync while the structure evolves (new lows during BOUNCE_WATCH move the
// weak-bounce ceiling and invalidation levels too).
var line  pkLine = na
var line  loLine = na
var line  l50    = na
var line  l786   = na
var label pkLab  = na
var label loLab  = na

if newDrop
    line.delete(pkLine)
    line.delete(loLine)
    line.delete(l50)
    line.delete(l786)
    label.delete(pkLab)
    label.delete(loLab)
    y50  = lo + maxBounce * (pk - lo)
    y786 = lo + failRetr * (pk - lo)
    pkLine := line.new(bar_index, pk, bar_index + lvlBars, pk, color = color.red, width = 2)
    loLine := line.new(bar_index, lo, bar_index + lvlBars, lo, color = color.teal, width = 2)
    l50    := line.new(bar_index, y50, bar_index + lvlBars, y50, color = color.new(color.yellow, 30), style = line.style_dotted)
    l786   := line.new(bar_index, y786, bar_index + lvlBars, y786, color = color.new(color.purple, 30), style = line.style_dotted)
    pkLab  := label.new(bar_index, pk, "TOP " + str.tostring(pk, format.mintick), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
    loLab  := label.new(bar_index, lo, "LOW " + str.tostring(lo, format.mintick), style = label.style_label_up, color = color.teal, textcolor = color.white, size = size.small)
else if state >= 3 and not na(pkLine) and barstate.isconfirmed
    y50  = lo + maxBounce * (pk - lo)
    y786 = lo + failRetr * (pk - lo)
    line.set_y1(pkLine, pk)
    line.set_y2(pkLine, pk)
    line.set_y1(loLine, lo)
    line.set_y2(loLine, lo)
    line.set_y1(l50, y50)
    line.set_y2(l50, y50)
    line.set_y1(l786, y786)
    line.set_y2(l786, y786)
    line.set_x2(pkLine, bar_index + lvlBars)
    line.set_x2(loLine, bar_index + lvlBars)
    line.set_x2(l50, bar_index + lvlBars)
    line.set_x2(l786, bar_index + lvlBars)
    label.set_y(pkLab, pk)
    label.set_text(pkLab, "TOP " + str.tostring(pk, format.mintick))
    label.set_y(loLab, lo)
    label.set_text(loLab, "LOW " + str.tostring(lo, format.mintick))

if invalidated
    // it wasn't a blow-off -> wipe the failed structure off the chart
    line.delete(pkLine)
    line.delete(loLine)
    line.delete(l50)
    line.delete(l786)
    label.delete(pkLab)
    label.delete(loLab)
    pkLine := na
    loLine := na
    l50    := na
    l786   := na
    pkLab  := na
    loLab  := na
if rearmed
    // confirmed blow-off stays on the chart as a frozen record; just detach
    // the refs so the next pattern draws a fresh set
    pkLine := na
    loLine := na
    l50    := na
    l786   := na
    pkLab  := na
    loLab  := na

plotshape(newClimax,    title = "Climax",    style = shape.triangleup,   location = location.abovebar, color = color.orange, size = size.small, text = "CLIMAX")
plotshape(newDrop,      title = "Drop",      style = shape.triangledown, location = location.abovebar, color = color.red,    size = size.small, text = "DROP")
plotshape(newConfirmed, title = "Confirmed", style = shape.xcross,       location = location.abovebar, color = color.purple, size = size.normal, text = "BLOW-OFF 5/5")

bgcolor(state == 1 ? color.new(color.teal, 94) : state == 2 ? color.new(color.orange, 88) : state == 3 or state == 4 ? color.new(color.red, 90) : state == 5 ? color.new(color.purple, 88) : na)

// status table
var table t = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))
if barstate.islast
    stTxt = state == 0 ? "NEUTRAL" : state == 1 ? "UPTREND" : state == 2 ? "CLIMAX ⚠" : state == 3 ? "VICIOUS DROP" : state == 4 ? "BOUNCE WATCH" : "CONFIRMED 5/5"
    stCol = state == 5 ? color.purple : state >= 2 ? color.orange : state == 1 ? color.teal : color.gray
    table.cell(t, 0, 0, "State", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, stTxt, text_color = stCol, text_size = size.small)
    table.cell(t, 0, 1, "#1 trend", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 1, (trendOk ? "✔ " : "✘ ") + str.tostring(trendGain, "#.#") + " ATR / retr " + str.tostring(trendRetr, "#.##"), text_color = color.silver, text_size = size.tiny)
    table.cell(t, 0, 2, "Climax", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 2, (climaxOk ? "✔ " : "· ") + "x" + str.tostring(accelRatio, "#.#") + " / +" + str.tostring(aboveATR, "#.#") + " ATR / RSI " + str.tostring(rsi, "#"), text_color = color.silver, text_size = size.tiny)
    table.cell(t, 0, 3, "#2+#4 drop", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 3, (dropOk ? "✔ " : "· ") + str.tostring(dropAtrNow, "#.#") + " ATR", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 0, 4, "#3 benchmark", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 4, useBench ? (benchTopping ? "topping ✔" : "healthy") : "off", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 0, 5, "#5 bounce", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 5, na(dispRetr) ? "-" : "retr " + str.tostring(dispRetr, "#.##") + (weakVol ? " weak vol" : ""), text_color = color.silver, text_size = size.tiny)

// ---------------------------------------------------------------- scenario ("fan") projection
// Projects TEMPLATES of possible outcomes forward from the current state.
// These are NOT forecasts — each path shows one typical way the situation
// resolves, so you can see where the scenarios diverge and where the
// decision levels sit. ① = pattern path, ② = bullish alt, ③ = bearish alt.

grpP = "Scenario projection"
showGhost = input.bool(true, "Draw scenario fan forward", group = grpP)
ghostBars = input.int(100, "Projection horizon (bars)", minval = 20, maxval = 400, group = grpP)

var ghosts    = array.new<polyline>()
var ghostLbls = array.new<label>()

// build one scenario path: offsets are fractions of the horizon, prices absolute
f_scenario(array<float> fracs, array<float> prices, color col, string name) =>
    pts = array.new<chart.point>()
    array.push(pts, chart.point.from_index(bar_index, close))
    for i = 0 to array.size(fracs) - 1
        array.push(pts, chart.point.from_index(bar_index + math.round(ghostBars * array.get(fracs, i)), array.get(prices, i)))
    array.push(ghosts, polyline.new(pts, curved = true, closed = false, line_color = col, line_style = line.style_dashed, line_width = 2))
    endP = array.get(prices, array.size(prices) - 1)
    array.push(ghostLbls, label.new(bar_index + ghostBars, endP, name, style = label.style_label_left, color = color.new(col, 75), textcolor = col, size = size.small))

if barstate.islast
    while array.size(ghosts) > 0
        polyline.delete(array.pop(ghosts))
    while array.size(ghostLbls) > 0
        label.delete(array.pop(ghostLbls))
    if showGhost and ready
        cGrey = color.new(color.gray,   25)   // primary pattern template
        cBull = color.new(color.teal,   35)   // bullish alternative
        cBear = color.new(color.maroon, 25)   // bearish alternative
        if state == 1 and chSlope > 0
            // ① blow-off template: toward the channel top -> parabolic -> crash -> weak bounce
            pkP = upperNow + chSlope * ghostBars * 0.55 + (chBreakATR + 1.5) * atr
            loP = pkP - dropATRIn * 1.2 * atr
            f_scenario(array.from(0.40, 0.55, 0.70, 0.85, 1.0), array.from(midNow + chSlope * ghostBars * 0.40 + 0.3 * (upperNow - midNow), pkP, loP, loP + maxBounce * 0.9 * (pkP - loP), loP - 0.5 * atr), cGrey, "① blow-off template")
            // ② orderly continuation: grinds along the channel, no climax
            f_scenario(array.from(0.33, 0.66, 1.0), array.from(midNow + chSlope * ghostBars * 0.33 - 0.5 * atr, midNow + chSlope * ghostBars * 0.66 + 0.5 * atr, midNow + chSlope * ghostBars), cBull, "② staircase continues")
            // ③ breakdown: no climax, the pullback deepens until criterion #1 dies
            adv = trendHi - trendLo
            if adv > 0
                failLevel = trendHi - maxRetrIn * adv
                halfLevel = trendHi - 0.5 * adv
                y1 = math.min(close - 0.5 * atr, halfLevel + 0.15 * adv)
                y2 = math.min(y1, halfLevel)
                y3 = math.min(y2, failLevel)
                f_scenario(array.from(0.35, 0.60, 1.0), array.from(y1, y2, y3), cBear, "③ breakdown — #1 dies < " + str.tostring(failLevel, format.mintick))
        else if state == 2
            pkP = math.max(close, upperNow) + 1.5 * atr
            loP = pkP - dropATRIn * 1.2 * atr
            // ① blow-off completes: one more spike, then the vicious drop
            f_scenario(array.from(0.20, 0.45, 0.70, 1.0), array.from(pkP, loP, loP + maxBounce * 0.9 * (pkP - loP), loP - 0.5 * atr), cGrey, "① blow-off completes")
            // ② squeeze continues — the classic trap for early shorts
            f_scenario(array.from(0.35, 0.70, 1.0), array.from(close + 2.0 * atr, close + 3.5 * atr, close + 4.5 * atr), cBull, "② squeeze continues!")
            // ③ fades back into the channel without a vicious drop
            f_scenario(array.from(0.30, 1.0), array.from(midNow + chSlope * ghostBars * 0.30, midNow + chSlope * ghostBars - 1.0 * atr), cBear, "③ fades into channel")
        else if (state == 3 or state == 4) and not na(pk) and not na(lo)
            bounceCeil = lo + maxBounce * (pk - lo)
            inval = lo + failRetr * (pk - lo)
            // ① weak bounce toward the ceiling, then rollover (confirmation path)
            f_scenario(array.from(0.35, 0.70, 1.0), array.from(math.min(bounceCeil, close + 1.5 * atr), lo, lo - 1.0 * atr), cGrey, "① weak bounce → down")
            // ② reclaim -> invalidation (the "grind to new highs" trap)
            f_scenario(array.from(0.40, 0.75, 1.0), array.from(bounceCeil, inval, pk), cBull, "② reclaims → invalid")
            // ③ base building at the low
            f_scenario(array.from(0.35, 0.70, 1.0), array.from(lo + 0.25 * (pk - lo), lo + 0.2 * (pk - lo), lo + 0.3 * (pk - lo)), cBear, "③ bases at the low")
        else if state == 5 and not na(pk) and not na(lo)
            // ① dead-cat fades below the low
            f_scenario(array.from(0.30, 0.65, 1.0), array.from(close + 0.5 * atr, lo, lo - 1.5 * atr), cGrey, "① dead-cat fades")
            // ② reclaim -> invalidation
            f_scenario(array.from(0.45, 1.0), array.from(lo + 0.5 * (pk - lo), lo + failRetr * (pk - lo)), cBull, "② reclaims → invalid")
            // ③ sharper flush
            f_scenario(array.from(0.40, 1.0), array.from(lo - 1.0 * atr, lo - 2.5 * atr), cBear, "③ capitulation")

// ---------------------------------------------------------------- alerts

// Dynamic messages: create ONE alert with "Any alert() function call"
if newClimax
    alert("[" + syminfo.ticker + "] CLIMAX WARNING: parabolic push " + str.tostring(aboveATR, "#.##") + " ATR above channel, RSI " + str.tostring(rsi, "#.#") + ", accel x" + str.tostring(accelRatio, "#.##") + ". Uptrend gain " + str.tostring(trendGain, "#.#") + " ATR, max retrace " + str.tostring(trendRetr, "#.###") + ".", alert.freq_once_per_bar)
if newDrop
    alert("[" + syminfo.ticker + "] VICIOUS DROP: " + str.tostring(dropAtrNow, "#.##") + " ATR off the peak on heavy volume (criteria #2+#4)." + (benchTopping ? " Benchmark also topping." : "") + " Watching the counter-rally.", alert.freq_once_per_bar)
if newConfirmed
    alert("[" + syminfo.ticker + "] BLOW-OFF TOP CONFIRMED (5/5): weak counter-rally (retrace " + str.tostring(dispRetr, "#.###") + "), benchmark topping: " + (benchTopping ? "yes" : "no/unknown") + ". Top " + str.tostring(pk, format.mintick) + " -> low " + str.tostring(lo, format.mintick) + ".", alert.freq_once_per_bar)
if reclaimReset
    alert("[" + syminfo.ticker + "] RESET: " + (rearmed ? "confirmed pattern re-armed — structure reclaimed" : "price reclaimed the drop — not a blow-off top (the 'grind higher' trap)") + ".", alert.freq_once_per_bar)

// Static alertcondition entries (single-stage alert setups)
alertcondition(newClimax,    "Blowoff: CLIMAX WARNING", "Parabolic climax above channel — blow-off top forming?")
alertcondition(newDrop,      "Blowoff: VICIOUS DROP",   "Vicious drop on heavy volume — watching the counter-rally")
alertcondition(newConfirmed, "Blowoff: CONFIRMED 5/5",  "Blow-off top confirmed: weak counter-rally")
alertcondition(reclaimReset, "Blowoff: INVALIDATED",    "Price reclaimed the drop — pattern invalidated")
